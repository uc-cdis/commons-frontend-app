NEXT_PUBLIC_GEN3_COMMONS_NAME=gen3
NEXT_PUBLIC_GEN3_API=http://localhost:3000
# uncomment and set the follow to connect the development frontend to a Gen3 commons backend. Note that the
# configuration in config needs to match the backend.
NEXT_PUBLIC_GEN3_API_TARGET=https://genomicaicommons.org
GEN3_AGENT_BASE_URL=https://genomicaicommons.org/agent
# turn off copilotkit's anonymous usage telemetry. one server-side setting covers the
# browser too: the server passes it on, so no NEXT_PUBLIC_ copy is needed
COPILOTKIT_TELEMETRY_DISABLED=true
