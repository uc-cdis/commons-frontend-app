NEXT_PUBLIC_GEN3_COMMONS_NAME=gen3
# chat's agent inside the cluster; a helm env value overrides this if the agent moves
GEN3_AGENT_BASE_URL=http://gdc-agent
# if you are using a config based deployment set these in your helm values.yaml file
# Set this for DATADOG tracking
# DATACOMMONS="commons_frontend_app"
# DATADOG_APPLICATION_ID=""
# DATADOG_CLIENT_TOKEN=""
# turn off copilotkit's anonymous usage telemetry. one server-side setting covers the
# browser too: the server passes it on, so no NEXT_PUBLIC_ copy is needed
COPILOTKIT_TELEMETRY_DISABLED=true
