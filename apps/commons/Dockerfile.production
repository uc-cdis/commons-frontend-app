# docker build -t gen3:gac -f apps/commons/Dockerfile.production .
# docker run -p 3000:3000 -it gen3:gac
# Build from the repo root, not this folder: npm workspaces need the root lockfile
# Dependency stage
FROM --platform=$BUILDPLATFORM node:24.22.1-alpine3.23 AS deps

ARG TARGETPLATFORM
ARG BUILDPLATFORM
ARG TARGETARCH
WORKDIR /gen3

# Copy dependency files first for better caching
# npm ci needs the root manifest, the lockfile and each workspace's manifest
COPY package.json package-lock.json ./
COPY apps/commons/package.json ./apps/commons/
COPY packages/chat/package.json ./packages/chat/
COPY packages/services_ui/package.json ./packages/services_ui/

# Install ALL dependencies once (including dev deps for build)
RUN npm config set fetch-retries 5 && \
    npm config set fetch-retry-mintimeout 20000 && \
    npm config set fetch-retry-maxtimeout 120000 && \
    npm ci && \
    npm cache clean --force

# JupyterLite stage
# Needs only node_modules, so it builds in parallel with the app and stays cached on code changes
FROM deps AS jupyterlite

# Install Python for JupyterLite build
RUN apk add --no-cache python3 py3-pip bash curl bzip2 uv git coreutils

COPY apps/commons/docker/micromamba-stub.py /usr/local/bin/micromamba
RUN chmod +x /usr/local/bin/micromamba

# Download cockle WASM packages into the remote-private lite-dir so prepare_wasm.js
# finds cockle_wasm_env/bin/fs.js at the correct relative path (cwd = lite-dir).
# @gen3/workspaces is hoisted to the root node_modules
RUN LITE_DIR=node_modules/@gen3/workspaces/dist/jupyterlite-builds/remote-private && \
    WASM_ENV="$LITE_DIR/cockle_wasm_env" && \
    mkdir -p "$WASM_ENV" && \
    for URL in \
      "https://repo.prefix.dev/emscripten-forge-4x/emscripten-wasm32/cockle_fs-0.3.0-h8b79025_1.tar.bz2" \
      "https://repo.prefix.dev/emscripten-forge-4x/emscripten-wasm32/coreutils-9.10-h072c4ef_2.tar.bz2" \
      "https://repo.prefix.dev/emscripten-forge-4x/emscripten-wasm32/grep-3.12-h8b79025_0.tar.bz2" \
      "https://repo.prefix.dev/emscripten-forge-4x/emscripten-wasm32/less-693-hf259948_0.tar.bz2" \
      "https://repo.prefix.dev/emscripten-forge-4x/emscripten-wasm32/sed-4.9-h072c4ef_0.tar.bz2" \
    ; do \
      curl -fsSL "$URL" | tar -xj -C "$WASM_ENV"; \
    done

# Sample notebooks for the free tier. jupyter-lite build picks up <lite-dir>/files as
# contents and generates the contents index, so they show in the file browser
COPY apps/commons/data/free_files node_modules/@gen3/workspaces/dist/jupyterlite-builds/free-private/files

# Build JupyterLite static assets
# Run from apps/commons so builds/ and jupyter-workspaces/ both end up there
RUN cd apps/commons && npm run build:jupyterlite

# Build stage
FROM deps AS builder
# 2 page-data workers instead of 7, so next build fits alongside jupyterlite in 8 GB
ARG NEXT_BUILD_WORKERS=2

# Copy necessary config files
COPY apps/commons/next.config.js apps/commons/tsconfig.json apps/commons/tailwind.config.js apps/commons/postcss.config.js ./apps/commons/
COPY apps/commons/.env.production ./apps/commons/

# Copy source files
COPY packages/chat/tsconfig.build.json ./packages/chat/
COPY packages/chat/src ./packages/chat/src
COPY packages/services_ui/tsconfig.build.json ./packages/services_ui/
COPY packages/services_ui/src ./packages/services_ui/src
COPY apps/commons/src ./apps/commons/src
COPY apps/commons/public ./apps/commons/public
COPY apps/commons/config ./apps/commons/config
COPY apps/commons/start.sh ./apps/commons/

# The app imports @gen3/chat and @gen3/services_ui from dist/, so build them first
RUN npm run build -w @gen3/chat
RUN npm run build -w @gen3/services_ui

# Build
RUN NODE_OPTIONS="--max-old-space-size=6144" npm run build -w @gen3/commons-portal-app-base

# Production stage
FROM node:24.22.1-alpine3.23 AS runner

WORKDIR /gen3

# TEMPORARY: curl for testing outbound access from the container, remove when done
RUN apk add --no-cache curl

# server.js lives here inside the standalone output
ARG APP=.next/standalone/apps/commons

RUN addgroup --system --gid 1001 nextjs && \
    adduser --system --uid 1001 nextjs

# The standalone output mirrors the repo, so server.js is at standalone/apps/commons/
COPY --from=builder --chown=nextjs:nextjs /gen3/apps/commons/.next/standalone ./.next/standalone
COPY --from=builder --chown=nextjs:nextjs /gen3/apps/commons/.next/static $APP/.next/static
COPY --from=builder --chown=nextjs:nextjs /gen3/apps/commons/start.sh ./start.sh
COPY --from=builder --chown=nextjs:nextjs /gen3/apps/commons/public ./public
COPY --from=builder --chown=nextjs:nextjs /gen3/apps/commons/config ./config
# Keep this at /gen3/jupyter-workspaces: @gen3/workspaces reads assets from that path
COPY --from=jupyterlite --chown=nextjs:nextjs /gen3/apps/commons/jupyter-workspaces ./jupyter-workspaces

# server.js runs from $APP, so the image cache and links go there (absolute, so depth doesn't matter)
# The traced config/ has only 1 of 26 files, so swap it for a link to the full copy
RUN mkdir -p $APP/.next/cache/images && \
    chmod -R 777 $APP/.next/cache && \
    chown -R nextjs:nextjs $APP/.next/cache && \
    chmod +x start.sh && \
    chown -R nextjs:nextjs start.sh && \
    rm -rf $APP/config && \
    ln -s "$(pwd)/config" $APP/config && \
    ln -s "$(pwd)/public" $APP/public && \
    ln -s "$(pwd)/jupyter-workspaces" $APP/jupyter-workspaces && \
    ln -s "$(pwd)/jupyter-workspaces/assets/free" "$(pwd)/public/jupyter"

USER nextjs:nextjs

ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1

CMD ["sh", "./start.sh"]
