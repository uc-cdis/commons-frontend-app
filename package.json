{
  "name": "@gen3/commons-portal-app-base",
  "version": "0.12.69",
  "private": "true",
  "engines": {
    "npm": ">=11.16.0",
    "node": ">=24.18.1"
  },
  "scripts": {
    "lint": "oxlint .",
    "lint-fix": "eslint . --fix",
    "predev": " NODE_ENV=development npm run build:middlewarePaths",
    "dev": "next dev --webpack",
    "dev:turbopack": "next dev",
    "prebuild": "NODE_ENV=production npm run build:middlewarePaths",
    "build": "next build --webpack",
    "build:volume": "npm run build:middlewarePathsMatchAll && next build --webpack",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "setupCommons": "npm run buildColors && npm run getSchema && npm run getDRSToHostname && npm run buildIcons && npm run build:middlewarePaths",
    "build:docker": "docker build -t gen3:fef_app -f Dockerfile.production .",
    "build:colors": "node ./node_modules/@gen3/toolsff/dist/buildColors.esm.js --themeFile=config/$npm_config_commons/colors.json --out=config/$npm_config_commons",
    "build:icons": "node ./node_modules/@gen3/toolsff/dist/bundleIcons.esm.js --inpath=config/icons --outpath=config/icons",
    "build:middlewarePaths": "if [ ! -f ./node_modules/@gen3/toolsff/dist/scanSitePaths.esm.js ]; then printf \"\\033[31mError: @gen3/toolsff not built (missing dist file). Run: npm run build:tools\\033[0m\\n\"; exit 1; else node ./node_modules/@gen3/toolsff/dist/scanSitePaths.esm.js || (printf \"\\033[31mError: @gen3/toolsff scanSitePaths failed. See above message\\033[0m\\n\" && exit 1); fi",
    "build:middlewarePathsMatchAll": "if [ ! -f ./node_modules/@gen3/toolsff/dist/scanSitePaths.esm.js ]; then printf \"\\033[31mError: @gen3/toolsff not built (missing dist file). Run: npm run build:tools\\033[0m\\n\"; exit 1; else node ./node_modules/@gen3/toolsff/dist/scanSitePaths.esm.js --forceMatchAll || (printf \"\\033[31mError: @gen3/toolsff scanSitePaths failed. See above message\\033[0m\\n\" && exit 1); fi",
    "getSchema": "node ./node_modules/@gen3/toolsff/dist/getSchema.esm.js --out=config/",
    "getDRSToHostname": "node ./node_modules/@gen3/toolsff/dist/getDRSToHostname.esm.js --out=config/",
    "build:jupyterlite:gen3sdk": "bash ./node_modules/@gen3/workspaces/dist/jupyterlite-builds/scripts/build-gen3sdk-lite.sh ./builds",
    "build:jupyterlite:setupenv": "bash ./node_modules/@gen3/workspaces/dist/jupyterlite-builds/scripts/setup-env.sh ./builds",
    "build:jupyterlite:free": "bash ./node_modules/@gen3/workspaces/dist/jupyterlite-builds/scripts/build-jupyterlite.sh free ./builds",
    "build:jupyterlite:remote": "bash ./node_modules/@gen3/workspaces/dist/jupyterlite-builds/scripts/build-jupyterlite.sh remote ./builds",
    "build:jupyterlite:assets": "bash ./node_modules/@gen3/workspaces/dist/jupyterlite-builds/scripts/sync-jupyter-assets-into-package.sh ./builds",
    "build:jupyterlite": "npm run build:jupyterlite:setupenv && npm run build:jupyterlite:gen3sdk && npm run build:jupyterlite:free && npm run build:jupyterlite:remote && npm run build:jupyterlite:assets"
  },
  "dependencies": {
    "@datadog/browser-rum": "^6.22.0",
    "@fontsource/montserrat": "^5.2.8",
    "@fontsource/poppins": "^5.2.7",
    "@fontsource/source-sans-pro": "^5.2.5",
    "@gen3/core": "^0.12.69",
    "@gen3/frontend": "^0.12.69",
    "@gen3/workspaces": "^0.12.69",
    "@mantine/core": "^9.4.0",
    "@mantine/dates": "^9.4.0",
    "@mantine/form": "^9.4.0",
    "@mantine/hooks": "^9.4.0",
    "@mantine/modals": "^9.4.0",
    "@mantine/notifications": "^9.4.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.0",
    "idb": "^8.0.3",
    "jsonpath-plus": "^10.3.0",
    "lodash": "^4.17.23",
    "mantine-react-table-open": "^9.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-styled-components": "^2.2.0",
    "use-deep-compare": "^1.3.0",
    "victory": "^37.3.6"
  },
  "devDependencies": {
    "@axe-core/react": "^4.10.2",
    "@chromatic-com/storybook": "^5.3.1",
    "@gen3/toolsff": "^0.12.69",
    "@graphiql/react": "^0.37.7",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-onboarding": "^10.6.0",
    "@storybook/nextjs": "^10.6.0",
    "@storybook/test-runner": "^0.24.5",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/lodash": "^4.17.23",
    "@types/mdx": "^2.0.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "axe-playwright": "^2.2.2",
    "graphiql": "^5.2.4",
    "jest-fixed-jsdom": "^0.0.10",
    "msw": "^2.11.5",
    "msw-storybook-addon": "^2.0.4",
    "next": "^16.3.0",
    "next-router-mock": "^1.0.5",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "postcss-loader": "^8.2.0",
    "postcss-modules": "^6.0.1",
    "postcss-preset-env": "^10.4.0",
    "postcss-preset-mantine": "^1.18.0",
    "prettier": "^3.6.2",
    "sharp": "^0.34.4",
    "storybook": "^10.6.0",
    "storybook-addon-deep-controls": "^0.10.0",
    "swr": "^2.3.6",
    "tailwindcss": "^3.4.18",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "eslint-plugin-storybook": "10.6.0"
  },
  "allowScripts": {
    "esbuild": true,
    "core-js-pure": true,
    "unrs-resolver": true,
    "fsevents": true,
    "msw": true,
    "sharp": true,
    "@swc/core": true,
    "@parcel/watcher": true
  }
}
