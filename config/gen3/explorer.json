            "title": "JSON",
            "leftIcon": "datafile",
            "rightIcon": "download",
            "action": "data-json",
            "actionArgs": {
              "filename": "bcca_assays.json"
            }
          },
          {
            "enabled": true,
            "type": "data-csv",
            "title": "CSV",
            "leftIcon": "datafile",
            "rightIcon": "download",
            "action": "data-csv",
            "actionArgs": {
              "filename": "bcca_assays.csv"
            }
          }
        ]
      }
    },
    "buttons": [
      {
        "enabled": true,
        "type": "manifest",
        "action": "manifest",
        "title": "Download Manifest",
        "leftIcon": "datafile",
        "rightIcon": "download",
