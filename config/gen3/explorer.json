            "value": "snp",
            "label": "SNP"
          },
          {
            "value": "chromium",
            "label": "Chromium"
          },
          {
            "value": "visium",
            "label": "Visium"
          },
          {
            "value": "xenium",
            "label": "Xenium"
          }
