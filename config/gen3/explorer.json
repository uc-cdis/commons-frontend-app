            "reports.assay_type",
            "reports.pipeline"
          ]
        },
        {
          "title": "Tissue",
          "fields": [
            "tissue_type",
            "tissue_category",
            "tissue_site",
            "therapeutic_status",
            "er_status",
            "pr_status",
            "her2_ihc",
            "clinical_subtype",
            "grade"
