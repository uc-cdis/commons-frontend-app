        },
        {
          "title": "Donor",
          "fields": [
            "age_at_diagnosis",
            "menopausal_status",
            "bc_type",
            "donor_clinical_subtype",
            "donor_core_clinical_subtype",
            "survival_status",
            "overall_survival"
          ]
        }
      ]
    },
    "table": {
      "enabled": true,
      "pageLimit": {
        "limit": 10000
      },
      "fields": [
        "gussid",
        "modality",
        "phenotype",
        "compartment",
