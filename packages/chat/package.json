{
  "name": "@gen3/chat",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "default": "./dist/ui/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/styles.css dist/",
    "dev": "tsc -p tsconfig.build.json --watch",
    "dev:css": "node --watch-path=src scripts/copy-styles.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "katex": "^0.16.28",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@ag-ui/client": "1.0.2",
    "@copilotkit/react-core": "^1.80.0",
    "@copilotkit/runtime": "^1.80.0",
    "@mantine/core": ">=9",
    "@mantine/hooks": ">=9",
    "@tabler/icons-react": "*",
    "next": "^16",
    "react": "^19.2",
    "react-dom": "^19.2",
    "recharts": ">=3"
  }
}
