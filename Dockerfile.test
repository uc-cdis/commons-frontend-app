# syntax=docker/dockerfile:1
# docker build -t ff .
# docker run -p 3000:3000 -it ff
# JupyterLite stage - independent of the Next.js build. It only needs the
# scripts/config shipped in the @gen3/workspaces npm package (version taken from
# package.json), so it is cached separately and BuildKit builds it in parallel
# with the `builder` stage. Output lands in /lite/work/jupyter-workspaces.
FROM node:24.22.1-alpine3.23 AS lite

RUN apk add --no-cache python3 py3-pip bash curl bzip2 uv git coreutils

# Stub that satisfies prepare_wasm.js without the glibc-linked micromamba binary.
COPY docker/micromamba-stub.py /usr/local/bin/micromamba
RUN chmod +x /usr/local/bin/micromamba

# Fetch just the @gen3/workspaces tarball (no dependencies) at the version
# pinned in package.json. Layout: /lite/package/dist/jupyterlite-builds/...
COPY package.json /tmp/package.json
RUN mkdir -p /lite && cd /tmp && \
    VER="$(node -p "require('/tmp/package.json').dependencies['@gen3/workspaces']")" && \
    npm pack "@gen3/workspaces@${VER}" --silent && \
    tar -xzf *.tgz -C /lite && \
    rm -f *.tgz

ENV LITE_ROOT=/lite/package/dist/jupyterlite-builds

# Download cockle WASM packages. prepare_wasm.js runs with cwd=lite-dir, so the
# env must live inside the remote tier's lite-dir (remote-private).
RUN WASM_ENV=${LITE_ROOT}/remote-private/cockle_wasm_env && \
    mkdir -p "$WASM_ENV" && \
    for URL in \
      "https://repo.prefix.dev/emscripten-forge-4x/emscripten-wasm32/cockle_fs-0.3.0-h8b79025_1.tar.bz2" \
      "https://repo.prefix.dev/emscripten-forge-4x/emscripten-wasm32/coreutils-9.10-h072c4ef_2.tar.bz2" \
      "https://repo.prefix.dev/emscripten-forge-4x/emscripten-wasm32/grep-3.12-h8b79025_0.tar.bz2" \
      "https://repo.prefix.dev/emscripten-forge-4x/emscripten-wasm32/less-693-hf259948_0.tar.bz2" \
      "https://repo.prefix.dev/emscripten-forge-4x/emscripten-wasm32/sed-4.9-h072c4ef_0.tar.bz2" \
    ; do \
      curl -fsSL "$URL" | tar -xj -C "$WASM_ENV"; \
    done

# Equivalent to `npm run build:jupyterlite`
WORKDIR /lite/work
RUN --mount=type=cache,target=/root/.cache/uv \
    S=${LITE_ROOT}/scripts && \
    bash $S/setup-env.sh ./builds && \
    bash $S/build-gen3sdk-lite.sh ./builds && \
    bash $S/build-jupyterlite.sh free ./builds && \
    bash $S/build-jupyterlite.sh remote ./builds && \
    bash $S/sync-jupyter-assets-into-package.sh ./builds && \
    find ./jupyter-workspaces -name '*.map' -delete && \
    ! find ./jupyter-workspaces -name '*.map' | grep -q .

# Build stage
FROM --platform=$BUILDPLATFORM node:24.22.1-alpine3.23 AS builder

ARG TARGETPLATFORM
ARG BUILDPLATFORM
ARG TARGETARCH
WORKDIR /ci

RUN apk add --no-cache git

# Copy dependency files first for better caching
COPY package.json package-lock.json ./

# Install ALL dependencies once (including dev deps for build)
RUN --mount=type=cache,target=/root/.npm \
    npm config set fetch-retries 5 && \
    npm config set fetch-retry-mintimeout 20000 && \
    npm config set fetch-retry-maxtimeout 120000 && \
    npm ci --no-audit --no-fund

# Copy necessary config files
COPY next.config.js tsconfig.json tailwind.config.js postcss.config.js ./
COPY .env.test ./

# Copy source files
COPY ./src ./src
COPY ./public ./public
COPY ./config ./config
COPY ./start_ci.sh ./

ENV NODE_ENV=test

# Build
RUN --mount=type=cache,target=/ci/.next/cache \
    NODE_OPTIONS="--max-old-space-size=4096" npm run build

# Fail the build if Next.js ever starts emitting browser sourcemaps
# (productionBrowserSourceMaps is off by default).
RUN ! find .next/standalone .next/static -name '*.map' | grep -q .

# Production stage
FROM node:24.22.1-alpine3.23 AS runner

WORKDIR /ci

RUN addgroup --system --gid 1001 nextjs && \
    adduser --system --uid 1001 nextjs && \
    rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx /opt/yarn-* /usr/local/bin/yarn /usr/local/bin/yarnpkg

COPY --from=builder --chown=nextjs:nextjs /ci/.next/standalone ./.next/standalone
COPY --from=builder --chown=nextjs:nextjs /ci/.next/static ./.next/standalone/.next/static
COPY --from=builder --chown=nextjs:nextjs --chmod=755 /ci/start_ci.sh ./start_ci.sh
COPY --from=builder --chown=nextjs:nextjs /ci/public ./public
COPY --from=builder --chown=nextjs:nextjs /ci/config ./config
COPY --from=lite --chown=nextjs:nextjs /lite/work/jupyter-workspaces ./jupyter-workspaces

RUN mkdir -p .next/standalone/.next/cache/images && \
    chmod -R 777 .next/standalone/.next/cache && \
    chown -R nextjs:nextjs .next/standalone/.next/cache && \
    rm -rf .next/standalone/config && \
    cd .next/standalone && \
    ln -s ../../config ./config && \
    ln -s ../../public ./public && \
    ln -s ../../jupyter-workspaces ./jupyter-workspaces

USER nextjs:nextjs

ENV NODE_ENV=test \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1

CMD ["sh", "./start_ci.sh"]
